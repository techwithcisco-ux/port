# apps/api local development environment.
# Copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql://branchport:password@localhost:5432/branchport
# REQUIRED — the API refuses to start without it (Render generates this
# automatically from render.yaml; locally use a long random string).
JWT_SECRET=generate-a-long-random-string
# Short-lived access tokens (default 15m). Refresh tokens live JWT_REFRESH_DAYS
# (default 30) as rotating opaque tokens stored hashed in refresh_tokens.
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
# Admin password for the Market analytics dashboard (POST /platform/login).
# Optional locally — leave unset to disable the market endpoints (503).
# MARKET_ADMIN_PASS=local-market-pass
PORT=8080
