# Backend REST API (apps/api). Required in production (e.g. the Render
# service https://branchport-api.onrender.com). Unset = local dev API.
# VITE_API_URL=https://branchport-api.onrender.com

# POS app URL (for cross-linking)
VITE_POS_URL=http://localhost:5174

# Public shop app URL (waitlist /w/:token links). render.yaml wires the
# Render service automatically; unset = local shop dev server.
# VITE_SHOP_URL=https://branchport-shop.onrender.com
