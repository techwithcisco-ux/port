# Supabase credentials (same project as BranchPort)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# BranchPort API URL (for cross-app calls via Edge Functions)
VITE_API_URL=https://your-branchport.vercel.app

# Admin credentials for Market Analytics login gate
# Default: admin / market2024 (change in production!)
VITE_MARKET_ADMIN_USER=admin
VITE_MARKET_ADMIN_PASS=your-secure-password-here
