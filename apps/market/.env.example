# Render Postgres path (recommended) — point at your apps/api service:
VITE_API_URL=https://branchport-api.onrender.com

# Legacy Supabase path (only if VITE_API_URL is unset):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin credentials for Market Analytics login gate
# Production fails closed with no password set — generate one per deploy
# (e.g. Render generateValue) and never commit it.
VITE_MARKET_ADMIN_USER=admin
VITE_MARKET_ADMIN_PASS=your-secure-password-here
